{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "savely-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.1
    }
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "66ad293921d54eaa8859d5ac4befd993"
    }
  ],
  // Self-hosted Postgres on the Hetzner box. Hyperdrive is REQUIRED, not
  // optional: raw Worker connect() egress is not inside Cloudflare's published
  // IP ranges, so a direct DATABASE_URL connection is dropped by the origin
  // firewall and times out. Hyperdrive egresses from in-range IPs.
  //
  // Commented out on 2026-08-03 after hitting the free-plan Hyperdrive query
  // cap (100k/day). The account moved to Workers Paid on 2026-08-16, which
  // removes that cap. Hyperdrive's own query cache is DISABLED on this config:
  // it is pooling we need here, not caching, and a cached query result would
  // defeat the on-demand invalidation layered above it. The database is 64MB
  // with a 99.97% buffer hit ratio, so uncached reads cost effectively nothing.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d1183b28d5734ea6816fe4ab559cb656"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
